{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/alt-text": "error"
  },
  "ignorePatterns": [
    ".agents/**",
    ".astro/**",
    "dist/**",
    "node_modules/**",
    "project.inlang/**",
    "src/env.d.ts",
    "src/paraglide/**",
    "srcparaglide/**",
    "pnpm-lock.yaml",
    "skills-lock.json"
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true
  }
}
