{
  "name": "ignacio-portfolio",
  "type": "module",
  "version": "2.2.0",
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src\\paraglide && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint --fix \"src/**/*.{js,ts,jsx,tsx,astro}\"",
    "postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src\\paraglide",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,astro}\"",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,astro}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/ts-plugin": "^1.10.4",
    "@inlang/paraglide-astro": "^0.3.5",
    "@tailwindcss/vite": "^4.0.3",
    "astro": "^5.2.3",
    "eslint-config-prettier": "^10.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.3",
    "tailwindcss-animated": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@inlang/paraglide-js": "1.11.8",
    "@typescript-eslint/parser": "^8.23.0",
    "astro-eslint-parser": "^1.2.1",
    "eslint": "^9.19.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript-eslint": "^8.23.0"
  }
}
