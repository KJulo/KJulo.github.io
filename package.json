{
  "name": "ignacio-portfolio",
  "version": "4.4.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run generate:resume-experience && astro dev",
    "start": "pnpm run generate:resume-experience && astro dev",
    "generate:resume-experience": "node scripts/generate-resume-experience.mjs",
    "prebuild": "pnpm run generate:resume-experience",
    "pretypecheck": "pnpm run generate:resume-experience",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && astro check && astro build",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "astro preview",
    "audit:lighthouse": "node scripts/audit.mjs",
    "astro": "astro",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "prepare": "husky",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@astrojs/ts-plugin": "1.11.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "7.4.11",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animated": "^2.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@inlang/paraglide-js": "3.2.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,astro}": [
      "oxfmt --write --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.14.0"
}
