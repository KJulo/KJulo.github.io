{
  "name": "ignacio-portfolio",
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src\\paraglide && astro sync && tsc --noEmit && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src\\paraglide",
    "prepare": "husky",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@astrojs/ts-plugin": "1.10.12",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animated": "^2.1.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "@inlang/paraglide-js": "2.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,astro}": [
      "oxfmt --write --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.14.0"
}
