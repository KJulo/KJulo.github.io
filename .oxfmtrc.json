{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "astro": true,
  "sortImports": true,
  "sortTailwindcss": true,
  "ignorePatterns": [
    ".agents/**",
    ".astro/**",
    "dist/**",
    "node_modules/**",
    "project.inlang/**",
    "src/env.d.ts",
    "src/paraglide/**",
    "pnpm-lock.yaml",
    "skills-lock.json",
    "report.html",
    "lh-baseline*.json"
  ]
}
