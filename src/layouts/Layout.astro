---
interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
}
const { title, description, noIndex = false } = Astro.props;

import Header from "@commons/Header/Header.astro";
import * as message from "@paraglide/messages";
import { searchLocale } from "@utils/language";

import "@styles/global.css";
import { ClientRouter } from "astro:transitions";

import {
  type Locale,
  getLocale,
  overwriteGetLocale,
} from "../paraglide/runtime";

// En Paraglide v2, necesitamos sobrescribir getLocale para detectar el idioma desde la URL
// durante el build/SSR ya que no hay integración de Astro
const detectedLocale = searchLocale(Astro.url.pathname);
overwriteGetLocale(() => detectedLocale as Locale);

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const routePath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const localizedPath = routePath.replace(/^\/es(?=\/|$)/, "") || "/";
const englishPath = localizedPath === "/" ? "/" : `${localizedPath}/`;
const spanishPath = localizedPath === "/" ? "/es/" : `/es${localizedPath}/`;
const canonicalPath = detectedLocale === "es" ? spanishPath : englishPath;
const canonicalUrl = new URL(canonicalPath, siteOrigin);
const profileImageUrl = new URL("/profile.webp", siteOrigin);
const robots = noIndex ? "noindex, nofollow" : "index, follow";
---

<!doctype html>
<html lang={getLocale()} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <ClientRouter />
    <script is:inline>
      function getTheme() {
        const savedTheme = localStorage.getItem("theme");
        return (
          savedTheme === "dark" ||
          (savedTheme === null &&
            window.matchMedia("(prefers-color-scheme: dark)").matches)
        );
      }

      function themeSwitcher() {
        const isDark = getTheme();
        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.style.colorScheme = isDark ? "dark" : "light";
      }

      themeSwitcher();
      document.addEventListener("astro:after-swap", themeSwitcher);
      document.addEventListener("astro:before-swap", (ev) => {
        const isDark = getTheme();
        ev.newDocument.documentElement.classList.toggle("dark", isDark);
        ev.newDocument.documentElement.style.colorScheme = isDark
          ? "dark"
          : "light";
      });
    </script>
    <style is:inline>
      html {
        background-color: #e5e7eb;
      }

      html.dark {
        background-color: #0a0a0a;
        color-scheme: dark;
      }
    </style>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noIndex && (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <link
          rel="alternate"
          hreflang="en"
          href={new URL(englishPath, siteOrigin)}
        />
        <link
          rel="alternate"
          hreflang="es"
          href={new URL(spanishPath, siteOrigin)}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(englishPath, siteOrigin)}
        />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#e5e7eb" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={profileImageUrl} />
    <meta
      property="og:locale"
      content={detectedLocale === "es" ? "es_CL" : "en_US"}
    />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-gray-200 text-zinc-900 dark:bg-neutral-950 dark:text-zinc-50">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-xl focus:bg-white focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-zinc-900 focus:shadow-lg focus:outline-2 focus:outline-offset-2 focus:outline-zinc-900 dark:focus:bg-neutral-900 dark:focus:text-white dark:focus:outline-white"
    >
      {message.skip_to_main()}
    </a>
    <Header />
    <main id="main-content" class="font-sans" transition:animate="fade">
      <slot />
    </main>
  </body>
</html>
