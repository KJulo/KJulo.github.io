---
interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
}
const { title, description, noIndex = false } = Astro.props;

import "@styles/global.css";
import { searchLocale } from "@utils/language";

import {
  type Locale,
  getLocale,
  overwriteGetLocale,
} from "../paraglide/runtime";

// En Paraglide v2, necesitamos sobrescribir getLocale para detectar el idioma desde la URL
// durante el build/SSR ya que no hay integración de Astro
const detectedLocale = searchLocale(Astro.url.pathname);
overwriteGetLocale(() => detectedLocale as Locale);

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const routePath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const localizedPath = routePath.replace(/^\/es(?=\/|$)/, "") || "/";
const englishPath = localizedPath === "/" ? "/" : `${localizedPath}/`;
const spanishPath = localizedPath === "/" ? "/es/" : `/es${localizedPath}/`;
const canonicalPath = detectedLocale === "es" ? spanishPath : englishPath;
const canonicalUrl = new URL(canonicalPath, siteOrigin);
const profileImageUrl = new URL("/profile.webp", siteOrigin);
const robots = noIndex ? "noindex, nofollow" : "index, follow";
---

<!doctype html>
<html lang={getLocale()} class="scroll-smooth">
  <head>
    <script is:inline>
      function themeSwitcher() {
        const savedTheme = localStorage.getItem("theme");
        const isDark =
          savedTheme === "dark" ||
          (savedTheme === null &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);

        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.style.colorScheme = isDark ? "dark" : "light";
      }
      themeSwitcher();
      document.addEventListener("astro:after-swap", themeSwitcher);
    </script>
    <style is:inline>
      html {
        background-color: #e5e7eb;
      }

      html.dark {
        background-color: #0a0a0a;
        color-scheme: dark;
      }
    </style>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(englishPath, siteOrigin)}
    />
    <link
      rel="alternate"
      hreflang="es"
      href={new URL(spanishPath, siteOrigin)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(englishPath, siteOrigin)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#e5e7eb" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={profileImageUrl} />
    <meta
      property="og:locale"
      content={detectedLocale === "es" ? "es_CL" : "en_US"}
    />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-gray-200 text-zinc-900 dark:bg-neutral-950 dark:text-zinc-50">
    <main class="font-sans">
      <slot />
    </main>
  </body>
</html>
