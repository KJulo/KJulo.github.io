---
import LanguageSwitcher from "@commons/LanguageSwitcher/LanguageSwitcher.astro";
import ThemeButton from "@commons/ThemeButton/ThemeButton.astro";
import { getLocale } from "@paraglide/runtime";
import { localizePathname } from "@utils/language";

const locale = getLocale();
const homeUrl = localizePathname("/", locale);
---

<header class="sticky top-0 z-40 w-full px-3 pt-3 sm:px-6 lg:px-8">
  <div class="glass mx-auto flex w-full max-w-[1440px] items-center justify-between rounded-2xl px-4 py-2.5 sm:px-5">
    <a
      href={homeUrl}
      class="group flex items-center gap-2 rounded-lg py-1 text-sm font-semibold tracking-tight text-zinc-900 transition-colors hover:text-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-800 sm:text-base dark:text-zinc-100 dark:hover:text-zinc-300 dark:focus-visible:outline-white"
    >
      <span
        class="inline-block size-2 rounded-full bg-emerald-500"
        aria-hidden="true"
      ></span>
      <span>Ignacio Silva</span>
    </a>

    <div class="flex items-center gap-2.5 sm:gap-3">
      <LanguageSwitcher />
      <ThemeButton />
    </div>
  </div>
</header>

<style>
  /* iOS-style glass: translucent, blurred and saturated, with a light rim. */
  .glass {
    position: relative;
    isolation: isolate;
    background: rgb(255 255 255 / 0.38);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    backdrop-filter: blur(18px) saturate(180%);
    border: 1px solid rgb(255 255 255 / 0.55);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.7),
      inset 0 -1px 0 rgb(255 255 255 / 0.15),
      0 8px 32px -12px rgb(24 24 27 / 0.25);
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  /* Specular sheen across the top half. */
  .glass::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.35),
      rgb(255 255 255 / 0) 55%
    );
  }

  :global(html.dark) .glass {
    background: rgb(23 23 23 / 0.42);
    border-color: rgb(255 255 255 / 0.1);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      inset 0 -1px 0 rgb(255 255 255 / 0.03),
      0 8px 32px -12px rgb(0 0 0 / 0.6);
  }

  :global(html.dark) .glass::before {
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.07),
      rgb(255 255 255 / 0) 55%
    );
  }

  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .glass {
      background: rgb(229 231 235 / 0.95);
    }
    :global(html.dark) .glass {
      background: rgb(10 10 10 / 0.95);
    }
  }
</style>
