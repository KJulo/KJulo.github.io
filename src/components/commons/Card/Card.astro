---
const { class: className, href, ariaLabel, target } = Astro.props;

const hasLink = Boolean(href);
---

{hasLink ? (
  <div
    class="h-full min-w-0 justify-center rounded-3xl border-2 border-solid text-center align-middle"
    class:list={[className]}
  >
    <a
      href={href}
      aria-label={ariaLabel}
      target={target}
      rel={target === "_blank" ? "noopener noreferrer" : undefined}
      class="flex h-full w-full flex-col place-items-center justify-center rounded-3xl text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900 dark:focus-visible:outline-white"
    >
      <slot />
    </a>
  </div>
) : (
  <div
    class="h-full min-w-0 justify-center rounded-3xl border-2 border-solid text-center align-middle"
    class:list={[className]}
  >
    <slot />
  </div>
)}
