---
import MoonIcon from "@icons/Moon.svg?raw";
import SunIcon from "@icons/Sun.svg?raw";
import * as message from "@paraglide/messages";
---

<button
  transition:persist
  type="button"
  class="relative flex size-8 cursor-pointer items-center justify-center rounded-full border border-zinc-300 bg-white/80 text-zinc-700 shadow-xs transition-colors hover:bg-zinc-100 hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-800 sm:size-9 dark:border-neutral-700 dark:bg-neutral-900/80 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white dark:focus-visible:outline-white"
  id="theme-selector-button"
  aria-label={message.theme_switcher_aria_label()}
>
  <span
    id="sun-icon-button"
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 flex scale-100 rotate-0 items-center justify-center text-amber-500 opacity-100 dark:scale-0 dark:-rotate-90 dark:opacity-0 [&>svg]:size-4 sm:[&>svg]:size-4.5"
    set:html={SunIcon}
  />
  <span
    id="moon-icon-button"
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 flex scale-0 rotate-90 items-center justify-center text-sky-400 opacity-0 dark:scale-100 dark:rotate-0 dark:opacity-100 [&>svg]:size-4 sm:[&>svg]:size-4.5"
    set:html={MoonIcon}
  />
</button>

<script>
  function toggleTheme() {
    const isDark = document.documentElement.classList.contains("dark");
    const nextTheme = isDark ? "light" : "dark";
    const root = document.documentElement;

    root.classList.add("theme-switching");
    localStorage.theme = nextTheme;
    root.classList.toggle("dark", nextTheme === "dark");
    root.style.colorScheme = nextTheme;

    requestAnimationFrame(() => {
      root.classList.remove("theme-switching");
    });
  }

  function init() {
    const button = document.getElementById("theme-selector-button");
    if (!button || button.dataset.listenerAttached === "true") return;

    button.dataset.listenerAttached = "true";
    button.addEventListener("click", toggleTheme);
  }

  init();
  document.addEventListener("astro:after-swap", init);
</script>
