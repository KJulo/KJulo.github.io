---
import { LANGUAGE_CODE } from "@constants/language";
import * as message from "@paraglide/messages";
import { getLocale } from "@paraglide/runtime";
import { switchLanguage } from "@utils/language";

const currentPath = `${Astro.url.pathname}`;
const lang = getLocale();

const isSpanishSelected = lang === LANGUAGE_CODE.SPANISH;
const isEnglishSelected = lang === LANGUAGE_CODE.ENGLISH;

const englishPath = switchLanguage(currentPath, "en");
const spanishPath = switchLanguage(currentPath, "es");
---

<div
  role="group"
  aria-label={message.language_label()}
  class="relative inline-flex h-8 items-center rounded-full border border-zinc-300 bg-white/80 p-0.5 text-xs font-semibold shadow-xs transition-colors sm:h-9 dark:border-neutral-700 dark:bg-neutral-900/80"
>
  <span
    aria-hidden="true"
    class:list={[
      "pointer-events-none absolute top-0.5 bottom-0.5 w-8 rounded-full bg-zinc-900 shadow-xs transition-transform duration-300 ease-out sm:w-9 dark:bg-white",
      isEnglishSelected
        ? "left-0.5 translate-x-0"
        : "left-0.5 translate-x-full",
    ]}
    transition:name="language-active-pill"
  ></span>

  <a
    href={englishPath}
    aria-label={message.lang_en()}
    aria-current={isEnglishSelected ? "page" : undefined}
    tabindex={isEnglishSelected ? -1 : undefined}
    class:list={[
      "relative z-10 inline-flex h-full w-8 items-center justify-center rounded-full transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-zinc-800 sm:w-9 dark:focus-visible:outline-white",
      isEnglishSelected
        ? "pointer-events-none text-white dark:text-zinc-950"
        : "text-zinc-600 hover:text-zinc-950 dark:text-neutral-400 dark:hover:text-white",
    ]}
  >
    EN
  </a>
  <a
    href={spanishPath}
    aria-label={message.lang_es()}
    aria-current={isSpanishSelected ? "page" : undefined}
    tabindex={isSpanishSelected ? -1 : undefined}
    class:list={[
      "relative z-10 inline-flex h-full w-8 items-center justify-center rounded-full transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-zinc-800 sm:w-9 dark:focus-visible:outline-white",
      isSpanishSelected
        ? "pointer-events-none text-white dark:text-zinc-950"
        : "text-zinc-600 hover:text-zinc-950 dark:text-neutral-400 dark:hover:text-white",
    ]}
  >
    ES
  </a>
</div>
