---
import { LANGUAGE_CODE } from "@constants/language";
import * as message from "@paraglide/messages";
import { type Locale, getLocale } from "@paraglide/runtime";
import { switchLanguage } from "@utils/language";

import Tooltip from "../Tooltip/Tooltip.astro";

const { textSize } = Astro.props;

const currentPath = `${Astro.url.pathname}`;
const lang = getLocale();
const switchPathname = switchLanguage(currentPath, lang as Locale);
const targetLanguageLabel =
  lang === LANGUAGE_CODE.SPANISH ? message.lang_en() : message.lang_es();

const isSpanishSelected = lang === LANGUAGE_CODE.SPANISH;
const isEnglishSelected = lang === LANGUAGE_CODE.ENGLISH;
---

<div class="flex h-full w-full">
  <a
    href={switchPathname}
    aria-label={targetLanguageLabel}
    class="flex h-full w-full items-center justify-center"
  >
    <div
      class:list={[
        "lg m-auto flex flex-row gap-2 rounded-xl p-4 text-center font-mono font-bold",
        `${textSize ? textSize : "text-4xl"}`,
      ]}
      data-animation="bonus"
    >
      <Tooltip
        class={`${isSpanishSelected ? "-translate-y-0.5" : " -translate-y-2"}`}
        text={message.lang_en()}
      >
        <span
          class:list={[
            "group/english -translate-y-2",
            `${isEnglishSelected ? "cursor-default" : "cursor-pointer text-neutral-500"}`,
          ]}
          aria-current={isEnglishSelected ? "page" : undefined}
        >
          {isSpanishSelected ? (
            <>
              En
              <span class="absolute -bottom-1 left-1/2 mb-1 h-1 w-0 rounded-r-full bg-black duration-150 group-hover/english:w-1/2 group-hover/english:transition-all dark:bg-white" />
              <span class="absolute right-1/2 -bottom-1 mb-1 h-1 w-0 rounded-l-full bg-black duration-150 group-hover/english:w-1/2 group-hover/english:transition-all dark:bg-white" />
            </>
          ) : (
            "En"
          )}
        </span>
      </Tooltip>
      <p>/</p>
      <Tooltip
        class=`${isEnglishSelected ? "translate-y-4" : "translate-y-2"}`
        text={message.lang_es()}
      >
        <span
          class:list={[
            "group/spanish translate-y-2",
            `${isSpanishSelected ? "cursor-default" : "cursor-pointer text-neutral-500"}`,
          ]}
          aria-current={isSpanishSelected ? "page" : undefined}
        >
          {isEnglishSelected ? (
            <>
              Es
              <span class="absolute -bottom-1 left-1/2 mb-1 h-1 w-0 rounded-r-full bg-black duration-150 group-hover/spanish:w-1/2 group-hover/spanish:transition-all dark:bg-white" />
              <span class="absolute right-1/2 -bottom-1 mb-1 h-1 w-0 rounded-l-full bg-black duration-150 group-hover/spanish:w-1/2 group-hover/spanish:transition-all dark:bg-white" />
            </>
          ) : (
            "Es"
          )}
        </span>
      </Tooltip>
    </div>
  </a>
</div>
