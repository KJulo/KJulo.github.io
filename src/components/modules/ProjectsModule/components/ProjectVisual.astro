---
import type { Project } from "@data/projects";

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
---

<div
  class:list={[
    "relative isolate overflow-hidden rounded-2xl border border-zinc-300 bg-zinc-100 p-3 shadow-inner dark:border-neutral-700 dark:bg-neutral-950",
    compact ? "aspect-[16/10]" : "aspect-[16/9]",
  ]}
  role="img"
  aria-label={project.isNda ? project.visualNdaLabel : project.visualLabel}
>
  <div
    class="flex items-center gap-1.5 border-b border-zinc-300 pb-2 dark:border-neutral-700"
    aria-hidden="true"
  >
    <span class="size-1.5 rounded-full bg-zinc-400 dark:bg-neutral-600"></span>
    <span class="size-1.5 rounded-full bg-zinc-400 dark:bg-neutral-600"></span>
    <span class="size-1.5 rounded-full bg-zinc-400 dark:bg-neutral-600"></span>
    <span class="ml-2 h-1.5 w-16 rounded-full bg-zinc-300 dark:bg-neutral-700"></span>
  </div>

  {project.isNda ? (
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-zinc-100/85 p-6 text-center backdrop-blur-sm dark:bg-neutral-950/85">
      <svg
        viewBox="0 0 24 24"
        class="size-8 text-zinc-500 dark:text-neutral-400"
        aria-hidden="true"
      >
        <path
          d="M7 10V7a5 5 0 0 1 10 0v3m-11 0h12v10H6V10Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
      </svg>
      <span class="max-w-44 text-sm font-medium text-zinc-600 dark:text-neutral-300">
        {project.visualNdaLabel}
      </span>
    </div>
  ) : project.visual === "happ-site" ? (
    <img
      src="/images/projects/happ-app-banner.png"
      alt=""
      class:list={[
        "absolute inset-0 size-full",
        project.visual === "happ-site"
          ? "bg-white object-contain"
          : "object-cover object-top",
      ]}
      loading="lazy"
    />
  ) : project.visual === "icar-transfer" ? (
    <img
      src="/images/projects/icar-transfer-hero.jpg"
      alt=""
      class="absolute inset-0 size-full object-cover object-top"
      loading="lazy"
    />
  ) : project.visual === "platform" ? (
    <div class="grid grid-cols-[30%_1fr] gap-3 pt-3" aria-hidden="true">
      <div class="space-y-2 rounded-lg bg-white p-2 dark:bg-neutral-900">
        <div class="h-2 w-3/4 rounded-full bg-zinc-300 dark:bg-neutral-700"></div>
        <div class="h-2 w-full rounded-full bg-zinc-200 dark:bg-neutral-800"></div>
        <div class="h-2 w-4/5 rounded-full bg-zinc-200 dark:bg-neutral-800"></div>
        <div class="h-2 w-3/5 rounded-full bg-zinc-200 dark:bg-neutral-800"></div>
      </div>
      <div class="space-y-3">
        <div class="h-6 w-3/5 rounded bg-blue-500/80"></div>
        <div class="grid grid-cols-3 gap-2">
          <div class="h-12 rounded-lg bg-blue-100 dark:bg-blue-500/15"></div>
          <div class="h-12 rounded-lg bg-zinc-200 dark:bg-neutral-800"></div>
          <div class="h-12 rounded-lg bg-zinc-200 dark:bg-neutral-800"></div>
        </div>
        <div class="h-14 rounded-lg border border-zinc-200 bg-white dark:border-neutral-800 dark:bg-neutral-900"></div>
      </div>
    </div>
  ) : (
    <div class="space-y-3 pt-3" aria-hidden="true">
      <div class="flex items-center justify-between">
        <div class="h-5 w-2/5 rounded bg-violet-500/80"></div>
        <div class="h-4 w-12 rounded-full bg-zinc-300 dark:bg-neutral-700"></div>
      </div>
      <div class="space-y-2 rounded-lg border border-zinc-200 bg-white p-3 dark:border-neutral-800 dark:bg-neutral-900">
        <div class="ml-auto h-5 w-2/5 rounded-md bg-violet-100 dark:bg-violet-500/20"></div>
        <div class="h-5 w-3/5 rounded-md bg-zinc-100 dark:bg-neutral-800"></div>
        <div class="ml-auto h-5 w-1/2 rounded-md bg-violet-100 dark:bg-violet-500/20"></div>
      </div>
      <div class="flex gap-2">
        <div class="h-5 grow rounded-full bg-zinc-200 dark:bg-neutral-800"></div>
        <div class="size-5 rounded-full bg-violet-500/80"></div>
      </div>
    </div>
  )}
</div>
