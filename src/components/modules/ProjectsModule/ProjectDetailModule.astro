---
import type { Project } from "@data/projects";
import ProjectVisual from "@modules/ProjectsModule/components/ProjectVisual.astro";
import { getLocale } from "@paraglide/runtime";
import { localizePathname } from "@utils/language";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section class="mx-auto w-full max-w-[1120px] px-4 py-6 sm:px-6 sm:py-10 lg:px-8 lg:py-14">
  <a
    href={localizePathname("/", getLocale())}
    class="inline-flex min-h-11 items-center rounded-md px-1.5 py-0.5 text-sm font-semibold text-zinc-700 underline decoration-zinc-400 underline-offset-4 transition-colors hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-800 dark:text-neutral-300 dark:decoration-neutral-600 dark:hover:text-white dark:focus-visible:outline-white"
  >
    {project.backLabel}
  </a>

  <article class="mt-7 overflow-hidden rounded-3xl border-2 border-zinc-300 bg-white dark:border-neutral-700 dark:bg-neutral-900">
    <div class="grid lg:grid-cols-[minmax(0,1.1fr)_minmax(20rem,0.9fr)]">
      <header class="p-6 sm:p-10">
        <div class="flex flex-wrap items-center gap-2 text-sm text-zinc-500 dark:text-neutral-400">
          <span>{project.label}</span>
          {project.isNda && (
            <span class="rounded-full border border-zinc-300 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:border-neutral-600 dark:text-neutral-300">
              {project.ndaLabel}
            </span>
          )}
        </div>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl dark:text-white">
          {project.title}
        </h1>
        <p class="mt-3 text-zinc-500 dark:text-neutral-400">
          {project.organization}
        </p>
        <p class="mt-6 max-w-xl text-lg leading-8 text-zinc-700 dark:text-neutral-200">
          {project.context}
        </p>
      </header>
      <div class="border-t border-zinc-200 p-5 sm:p-8 lg:border-t-0 lg:border-l dark:border-neutral-700">
        <ProjectVisual project={project} />
      </div>
    </div>

    <div class="grid border-t border-zinc-200 lg:grid-cols-[minmax(0,1.1fr)_minmax(20rem,0.9fr)] dark:border-neutral-700">
      <div class="p-6 sm:p-10">
        <h2 class="text-xl font-semibold text-zinc-950 dark:text-white">
          {project.challengeLabel}
        </h2>
        <p class="mt-3 max-w-2xl leading-7 text-zinc-700 dark:text-neutral-200">
          {project.challenge}
        </p>

        <h2 class="mt-9 text-xl font-semibold text-zinc-950 dark:text-white">
          {project.approachLabel}
        </h2>
        <ol class="mt-4 space-y-4">
          {project.approach.map((step, index) => (
            <li class="flex gap-3 leading-7 text-zinc-700 dark:text-neutral-200">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-violet-100 text-sm font-semibold text-violet-700 dark:bg-violet-500/20 dark:text-violet-200">
                {index + 1}
              </span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
      <aside class="border-t border-zinc-200 bg-zinc-50 p-6 sm:p-10 lg:border-t-0 lg:border-l dark:border-neutral-700 dark:bg-neutral-950/40">
        <dl class="space-y-7">
          <div>
            <dt class="text-sm font-semibold text-zinc-950 dark:text-white">
              {project.roleLabel}
            </dt>
            <dd class="mt-2 leading-7 text-zinc-700 dark:text-neutral-200">
              {project.role}
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-zinc-950 dark:text-white">
              {project.technologiesLabel}
            </dt>
            <dd class="mt-3 flex flex-wrap gap-2">
              {project.technologies.map((technology) => (
                <span class="rounded-full bg-white px-2.5 py-1 text-xs font-medium text-zinc-700 ring-1 ring-zinc-200 dark:bg-neutral-900 dark:text-neutral-200 dark:ring-neutral-700">
                  {technology}
                </span>
              ))}
            </dd>
          </div>
          <div class="border-l-2 border-violet-500 pl-3">
            <dt class="text-sm font-semibold text-zinc-950 dark:text-white">
              {project.resultLabel}
            </dt>
            <dd class="mt-2 leading-7 text-zinc-700 dark:text-neutral-200">
              {project.result}
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </article>
</section>
