---
import Tag from "@commons/Tag/Tag.astro";
import * as message from "@paraglide/messages";
---

<div class="flex h-full flex-col justify-center p-5 text-start sm:p-6">
  <Tag color="red" text={message.aboutMe_tag()} class="self-start" />
  <p class="mt-3 text-sm leading-6 text-zinc-700 sm:text-base sm:leading-7 dark:text-neutral-300">
    {message.aboutMe_description()}
  </p>
</div>
