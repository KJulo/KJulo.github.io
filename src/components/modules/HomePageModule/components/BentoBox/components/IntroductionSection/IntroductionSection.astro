---
import ProfilePictureHi from "@images/images/profile.webp";
import * as message from "@paraglide/messages";
import { Image } from "astro:assets";

const { projectsHref = "#projects" } = Astro.props;
---

<div class="flex h-full flex-col justify-center gap-5 p-5 text-start sm:gap-6 sm:p-8 lg:p-10">
  <div class="flex items-center gap-3.5 lg:hidden">
    <div class="size-14 shrink-0 overflow-hidden rounded-full border-2 border-zinc-200 bg-zinc-100 shadow-sm dark:border-neutral-700 dark:bg-neutral-800">
      <Image
        src={ProfilePictureHi}
        alt={message.profile_picture_greeting_alt()}
        class="size-full object-cover"
        loading="eager"
        fetchpriority="high"
        width={56}
        height={56}
      />
    </div>
    <p class="flex items-center gap-2 text-xs font-medium text-emerald-700 sm:text-sm dark:text-emerald-300">
      <span
        class="size-2 shrink-0 rounded-full bg-emerald-500"
        aria-hidden="true"
      ></span>
      {message.introduction_status()}
    </p>
  </div>
  <p class="hidden items-center gap-2 text-xs font-medium text-emerald-700 sm:text-sm lg:flex dark:text-emerald-300">
    <span
      class="size-2 shrink-0 rounded-full bg-emerald-500"
      aria-hidden="true"
    ></span>
    {message.introduction_status()}
  </p>
  <div class="max-w-3xl space-y-4">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-950 sm:text-4xl lg:text-5xl dark:text-white">
      {message.introduction_title()}
    </h1>
    <p class="max-w-2xl text-sm leading-6 text-neutral-700 sm:text-lg sm:leading-7 dark:text-neutral-300">
      {message.introduction_description()}
    </p>
  </div>
  <div
    class="flex flex-col gap-3 sm:flex-row"
    role="group"
    aria-label={message.introduction_actions_label()}
  >
    <a
      href={projectsHref}
      class="inline-flex min-h-11 items-center justify-center rounded-xl bg-zinc-900 px-5 py-3 font-semibold text-white transition-colors hover:bg-zinc-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200 dark:focus-visible:outline-white"
    >
      {message.introduction_projects_action()}
    </a>
    <a
      href="#contact"
      class="inline-flex min-h-11 items-center justify-center rounded-xl border border-zinc-400 px-5 py-3 font-semibold text-zinc-800 transition-colors hover:border-zinc-600 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900 dark:border-neutral-500 dark:text-zinc-100 dark:hover:border-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:outline-white"
    >
      {message.introduction_contact_action()}
    </a>
  </div>
</div>
