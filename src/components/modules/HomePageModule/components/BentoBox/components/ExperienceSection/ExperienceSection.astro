---
import Tag from "@components/commons/Tag/Tag.astro";
import RedirectIcon from "@icons/Redirect.svg?raw";
import type MessagesInterface from "@interfaces/MessagesInterface";
import * as message from "@paraglide/messages";
import { getLocale } from "@paraglide/runtime";
import { localizePathname } from "@utils/language";

import { createExperienceList } from "./utils";

const EXPERIENCES = createExperienceList(
  message as unknown as MessagesInterface,
);
---

<div class="flex h-full flex-col content-start gap-4 p-4">
  <Tag color="yellow" text={message.experience_tag()} class="self-start" />
  <ul class="flex flex-col gap-4">
    {EXPERIENCES.map((experience, index) => (
      <li
        class:list={[
          "flex flex-row justify-between gap-4",
          `${index + 1 !== EXPERIENCES.length ? "border-b pb-4" : ""}`,
        ]}
      >
        <div class="flex flex-col items-start text-left">
          <span>{experience.ROLE}</span>
          <span>{experience.COMPANY}</span>
        </div>
        <div class="flex flex-row text-right">
          <time datetime={experience.DATE_START_RAW}>
            {experience.DATE_START}
          </time>
          <span class="mx-2">&ndash;</span>
          <time datetime={experience.DATE_END_RAW}>{experience.DATE_END}</time>
        </div>
      </li>
    ))}
  </ul>
  <a
    href={localizePathname("/resume", getLocale())}
    aria-label={message.experience_action_aria_label()}
    data-astro-prefetch="viewport"
    class="group mt-auto inline-flex items-center gap-2 self-end rounded-xl bg-zinc-900 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-all hover:bg-zinc-800 hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900 active:scale-[0.98] dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200 dark:focus-visible:outline-white"
  >
    <span>{message.experience_action()}</span>
    <span
      set:html={RedirectIcon}
      class="inline-flex size-4 shrink-0 items-center justify-center stroke-current transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:group-hover:translate-none [&>svg]:size-full [&>svg]:stroke-current"
      aria-hidden="true"
    />
  </a>
</div>
