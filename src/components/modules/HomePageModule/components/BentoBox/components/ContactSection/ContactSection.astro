---
import GithubIcon from "@icons/Github.svg?raw";
import GitlabIcon from "@icons/Gitlab.svg?raw";
import LinkedInIcon from "@icons/LinkedIn.svg?raw";
import * as message from "@paraglide/messages";
---

<div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
  <div class="max-w-xl text-left">
    <h2
      id="contact-title"
      class="text-2xl font-bold tracking-tight text-zinc-950 sm:text-3xl dark:text-white"
    >
      {message.contact_title()}
    </h2>
    <p class="mt-2 text-sm leading-6 text-zinc-600 sm:text-base dark:text-neutral-300">
      {message.contact_description()}
    </p>
  </div>
  <div
    class="grid grid-cols-2 gap-3 sm:flex sm:flex-wrap lg:justify-end"
    aria-label={message.contact_links_label()}
  >
    <a
      href="mailto:ignacio.silva.e@gmail.com"
      class="group inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-red-300/80 bg-red-50/70 px-4 py-2.5 text-sm font-semibold text-red-700 transition-all hover:border-red-700 hover:bg-red-700 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700 dark:border-red-900/60 dark:bg-red-950/30 dark:text-red-300 dark:hover:border-red-600 dark:hover:bg-red-700 dark:hover:text-white dark:focus-visible:outline-white"
    >
      <svg
        class="size-4 shrink-0 transition-colors group-hover:stroke-white group-focus-visible:stroke-white"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
      <span>Email</span>
    </a>
    <a
      href="https://www.linkedin.com/in/ignaciosilvae/"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-sky-300/80 bg-sky-50/70 px-4 py-2.5 text-sm font-semibold text-sky-700 transition-all hover:border-sky-700 hover:bg-sky-700 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-700 dark:border-sky-900/60 dark:bg-sky-950/30 dark:text-sky-300 dark:hover:border-sky-600 dark:hover:bg-sky-700 dark:hover:text-white dark:focus-visible:outline-white"
    >
      <span
        class="size-4 shrink-0 [&>svg]:size-full [&>svg]:fill-current"
        set:html={LinkedInIcon}
        aria-hidden="true"
      />
      <span>LinkedIn</span>
    </a>
    <a
      href="https://github.com/KJulo"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-purple-300/80 bg-purple-50/70 px-4 py-2.5 text-sm font-semibold text-purple-700 transition-all hover:border-purple-700 hover:bg-purple-700 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-700 dark:border-purple-900/60 dark:bg-purple-950/30 dark:text-purple-300 dark:hover:border-purple-600 dark:hover:bg-purple-700 dark:hover:text-white dark:focus-visible:outline-white"
    >
      <span
        class="size-4 shrink-0 [&>svg]:size-full [&>svg]:fill-current"
        set:html={GithubIcon}
        aria-hidden="true"
      />
      <span>GitHub</span>
    </a>
    <a
      href="https://gitlab.com/isilva3"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-orange-300/80 bg-orange-50/70 px-4 py-2.5 text-sm font-semibold text-orange-700 transition-all hover:border-orange-800 hover:bg-orange-800 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-800 dark:border-orange-900/60 dark:bg-orange-950/30 dark:text-orange-300 dark:hover:border-orange-700 dark:hover:bg-orange-800 dark:hover:text-white dark:focus-visible:outline-white"
    >
      <span
        class="size-4 shrink-0 transition-colors group-hover:[&_.cls-1]:fill-white group-focus-visible:[&_.cls-1]:fill-white group-hover:[&_.cls-2]:fill-white group-focus-visible:[&_.cls-2]:fill-white group-hover:[&_.cls-3]:fill-white group-focus-visible:[&_.cls-3]:fill-white [&>svg]:size-full"
        set:html={GitlabIcon}
        aria-hidden="true"
      />
      <span>GitLab</span>
    </a>
  </div>
</div>
