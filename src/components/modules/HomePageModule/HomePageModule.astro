---
import ProjectsModule from "@modules/ProjectsModule/ProjectsModule.astro";

import BentoBox from "./components/BentoBox/BentoBox.astro";
import ContactSection from "./components/BentoBox/components/ContactSection/ContactSection.astro";
---

<div class="mx-auto flex w-full max-w-[1440px] flex-col gap-4 px-4 pt-4 pb-10 sm:gap-6 sm:px-6 sm:pt-6 sm:pb-12 lg:gap-8 lg:px-8 lg:pt-8 lg:pb-14">
  <section>
    <BentoBox />
  </section>

  <ProjectsModule />

  <section id="contact" class="scroll-mt-20" aria-labelledby="contact-title">
    <div class="rounded-3xl border-2 border-zinc-300 bg-white p-5 sm:p-8 lg:p-10 dark:border-neutral-700 dark:bg-neutral-900">
      <ContactSection />
    </div>
  </section>
</div>
