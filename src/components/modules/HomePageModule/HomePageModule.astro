---
import ProjectsModule from "@modules/ProjectsModule/ProjectsModule.astro";

import BentoBox from "./components/BentoBox/BentoBox.astro";
import ContactSection from "./components/BentoBox/components/ContactSection/ContactSection.astro";
---

<section class="mx-auto w-full max-w-[1440px] px-4 pt-4 pb-10 sm:px-6 sm:pt-6 lg:px-8 lg:pt-8 lg:pb-14">
  <BentoBox />
</section>

<ProjectsModule />

<section
  id="contact"
  class="mx-auto w-full max-w-[1440px] scroll-mt-6 px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14"
  aria-labelledby="contact-title"
>
  <div class="rounded-3xl border-2 border-zinc-300 bg-white p-6 sm:p-8 lg:p-10 dark:border-neutral-700 dark:bg-neutral-900">
    <ContactSection />
  </div>
</section>
