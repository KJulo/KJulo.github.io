---
import EmailIcon from "@icons/Mail.svg?raw";
import LocationIcon from "@icons/resume/Location.svg?raw";
import PhoneIcon from "@icons/resume/Phone.svg?raw";
import * as message from "@paraglide/messages";
---

<div>
  <h2 class="text-2xl">🪪 {message.resume_personalInformation_title()}</h2>
  <div class="mx-auto my-4 h-px w-full bg-neutral-300 dark:bg-neutral-600"></div>
  <ul>
    <li class="flex flex-row items-center gap-2 text-center">
      <span
        class="w-4 fill-neutral-800 dark:fill-neutral-200"
        set:html={LocationIcon}
        aria-hidden="true"
      />
      Santiago, Chile 🇨🇱
    </li>
    <li class="flex flex-row items-center gap-2 text-center">
      <span
        class="w-4 fill-neutral-800 dark:fill-neutral-200"
        set:html={PhoneIcon}
        aria-hidden="true"
      />
      <a
        href="tel:+56941205886"
        class="rounded-md text-blue-700 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-800 dark:text-blue-300 dark:focus-visible:outline-white"
      >
        +569 41205886
      </a>
    </li>
    <li class="flex flex-row items-center gap-2 text-center">
      <span
        class="w-4 fill-neutral-800 dark:fill-neutral-200"
        set:html={EmailIcon}
        aria-hidden="true"
      />
      <a
        href="mailto:ignacio.silva.e@gmail.com"
        class="rounded-md text-blue-700 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-800 dark:text-blue-300 dark:focus-visible:outline-white"
      >
        ignacio.silva.e@gmail.com
      </a>
    </li>
  </ul>
</div>
