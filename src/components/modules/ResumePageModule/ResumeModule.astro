---
import Hyperlink from "@commons/Hyperlink/Hyperlink.astro";
import Navbar from "@commons/Navbar/Navbar.astro";
import { LANGUAGE_CODE } from "@constants/language";
import type MessagesInterface from "@interfaces/MessagesInterface";
import * as message from "@paraglide/messages";
import { getLocale } from "@paraglide/runtime";
import { localizePathname } from "@utils/language";

import { getSections } from "./constants";

const SECTIONS = getSections(message as unknown as MessagesInterface);
const locale = getLocale();
const resumePdf =
  locale === LANGUAGE_CODE.SPANISH
    ? "/documents/CV-Español.pdf"
    : "/documents/CV-English.pdf";
---

<div class="mx-auto w-full max-w-5xl px-4 py-4 sm:px-6 lg:px-8">
  <div class="sticky top-16 z-30 flex justify-center py-2 transition-colors">
    <Navbar elements={SECTIONS} />
  </div>
  <div class="mt-4 flex flex-col gap-6">
    <div class="flex items-center justify-between">
      <Hyperlink
        href={localizePathname("/", locale)}
        target="_self"
        class="inline-flex items-center gap-1.5 rounded-full border border-zinc-300 bg-white/80 px-3.5 py-1.5 text-sm font-medium text-zinc-700 shadow-xs backdrop-blur-xs transition hover:bg-zinc-100 hover:text-zinc-900 dark:border-neutral-700 dark:bg-neutral-900/80 dark:text-zinc-300 dark:hover:bg-neutral-800 dark:hover:text-white"
        ariaLabel={message.notFound_back()}
      >
        ← {message.notFound_back()}
      </Hyperlink>
    </div>

    <div class="flex min-h-[86vh] flex-col gap-8 rounded-3xl border-2 border-zinc-300 bg-white p-6 sm:p-8 lg:p-10 dark:border-neutral-700 dark:bg-neutral-900">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-zinc-200 pb-6 dark:border-neutral-800">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          {message.resume_title()}
        </h1>
        <a
          href={resumePdf}
          download
          class="inline-flex items-center gap-2 rounded-full border border-zinc-300 bg-zinc-900 px-4 py-2 text-sm font-semibold text-white shadow-xs transition hover:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-800 dark:border-neutral-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-100 dark:focus-visible:outline-white"
        >
          <span>{message.resume_download()}</span>
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
        </a>
      </div>
      {SECTIONS.map((section) => (
        <div id={`${section.id}`} class="scroll-mt-32">
          <section.render />
        </div>
      ))}
    </div>
  </div>
</div>
