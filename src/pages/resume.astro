---
import Layout from "@layouts/Layout.astro";
import ResumeModule from "@modules/ResumePageModule/ResumeModule.astro";
import * as message from "@paraglide/messages";
import { type Locale, overwriteGetLocale } from "@paraglide/runtime";
import { searchLocale } from "@utils/language";

const locale = searchLocale(Astro.url.pathname);
overwriteGetLocale(() => locale as Locale);
---

<Layout
  title={`Ignacio Silva | ${message.resume_title()}`}
  description="Resume of Ignacio Silva, Front-end Developer from Chile, with experience building modern web applications."
>
  <ResumeModule />
</Layout>
